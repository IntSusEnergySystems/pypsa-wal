    log:
        "logs/build_report.log",
    shell:
        """
        set -e
        mkdir -p {DOCDIR}/figures
        cp {input.figures} {DOCDIR}/figures/
        export TECTONIC_CACHE_DIR=/sylvain/mount/pypsa-wal-data/tectonic-cache
        export XDG_CACHE_HOME=/sylvain/mount/pypsa-wal-data/xdg-cache
        {TECTONIC} -X compile --keep-logs {input.tex} > {log} 2>&1
        rm -f {DOCDIR}/pv_potential_wallonia.log
        """


