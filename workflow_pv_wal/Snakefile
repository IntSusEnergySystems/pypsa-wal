rule build_soils:
    message:
        "Agronomic soil quality onto the grid"
    params:
        gdal=PY,
    input:
        folder=f"{DATA}/soils_awac/.done",
        grid=f"{RES}/grid.json",
    output:
        f"{RES}/rasters/soil_quality.tif",
    log:
        "logs/build_soils.log",
    run:
        import json as _j

        g = _j.loads(Path(input.grid).read_text())
        src = next(Path(input.folder).parent.rglob("SOLS_QUALITE_AGRO.tif"))
        b = g["bounds"]
        shell(
            "{params.gdal}/gdalwarp -overwrite -t_srs EPSG:{g[crs]} -te {b[0]} {b[1]} {b[2]} {b[3]} "
            "-tr {g[res]} {g[res]} -r near -ot Byte -co COMPRESS=DEFLATE -co TILED=YES "
            "--config GTIFF_SRS_SOURCE EPSG {src} {output} > {log} 2>&1"
        )


