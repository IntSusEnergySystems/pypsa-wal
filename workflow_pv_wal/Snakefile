    input:
        regions=f"{RES}/regions.gpkg",
    output:
        grid=f"{RES}/grid.json",
        region_mask=f"{RES}/region_mask.tif",
    log:
        "logs/build_grid.log",
    resources:
        mem_mb=2000,
    script:
        "scripts/build_grid.py"


rule download_dem_province:
    message:
        "Downloading the LiDAR terrain model of {wildcards.prov}"
    params:
        url=lambda w: config["bulk"]["dem_lidar"]["url_pattern"].format(prov=w.prov),
    output:
        # temp(): removed once the province is warped (and only then, so a
        # failed warp does not throw away 10 GB of download).
        temp(f"{RES}/dem/MNT_1M_{{prov}}.zip"),
    log:
        "logs/download_dem_{prov}.log",
    resources:
        net=1,
        mem_mb=300,
    retries: 2
    shell:
        """
        rm -f {output}.part
        curl -sS -L --retry 5 -o {output}.part "{params.url}" > {log} 2>&1
        unzip -Z1 {output}.part >> {log} 2>&1
        mv {output}.part {output}
        """


rule retrieve_dem_province:
    message:
        "LiDAR terrain model of {wildcards.prov}: average onto the study grid"
    params:
        gdal=PY,
    input:
        grid=f"{RES}/grid.json",
        zip=f"{RES}/dem/MNT_1M_{{prov}}.zip",
    output:
        f"{RES}/dem/dem_{{prov}}.tif",
    log:
        "logs/retrieve_dem_{prov}.log",
    resources:
        mem_mb=1500,
    script:
        "scripts/retrieve_dem.py"


rule merge_dem:
    message:
        "Merging the provincial terrain models"
    params:
        gdal=PY,
    input:
        expand(f"{RES}/dem/dem_{{prov}}.tif", prov=PROVINCES),
    output:
        f"{RES}/dem_20m.tif",
    log:
        "logs/merge_dem.log",
    shell:
        """
        {params.gdal}/gdalbuildvrt -srcnodata -9999 -vrtnodata -9999 {RES}/dem/dem.vrt {input} > {log} 2>&1
        {params.gdal}/gdal_translate -co COMPRESS=DEFLATE -co PREDICTOR=3 -co TILED=YES \
            {RES}/dem/dem.vrt {output} >> {log} 2>&1
        """


rule retrieve_osm:
    message:
        "Retrieving ground-mounted PV plants and grid substations from OpenStreetMap"
    params:
        crs=config["grid"]["crs"],
    input:
        regions=f"{RES}/regions.gpkg",
    output:
        pv=f"{DATA}/osm_pv.gpkg",
        grid=f"{DATA}/osm_grid.gpkg",
        meta=f"{DATA}/osm.meta.json",
    log:
        "logs/retrieve_osm.log",
    resources:
        mem_mb=2000,
    retries: 2
    script:
        "scripts/retrieve_osm.py"


# ---------------------------------------------------------------------------
# Burning: every exclusion layer and gisement mask onto the 20 m grid
# ---------------------------------------------------------------------------
BURN = {**config["layers"], **config["masks"]}


def burn_sources(w):
    spec = BURN[w.layer]
    items = spec["source"] if isinstance(spec["source"], list) else [spec["source"]]
    return [f"{DATA}/{i if isinstance(i, str) else i['source']}.gpkg" for i in items]


rule burn_layer:
    message:
        "Burning {wildcards.layer} onto the grid"
    params:
        spec=lambda w: BURN[w.layer],
    input:
        sources=burn_sources,
        grid=f"{RES}/grid.json",
        region_mask=f"{RES}/region_mask.tif",
    output:
        raster=f"{RES}/layers/{{layer}}.tif",
        stats=f"{RES}/layers/{{layer}}.json",
    log:
        "logs/burn_{layer}.log",
    resources:
        mem_mb=2500,
    wildcard_constraints:
        layer="|".join(BURN),
    script:
        "scripts/burn_layer.py"


rule burn_all:
    input:
        expand(f"{RES}/layers/{{layer}}.tif", layer=BURN),


