# Stand-alone land-eligibility workflow for ground-mounted PV in Wallonia, the
# PV counterpart of workflow_onwind_wal/.  It shares nothing with the main
# PyPSA-Wal Snakefile except read-only inputs (region shapes, atlite cutout).
#
#   cd workflow_pv_wal
#   snakemake -c2 --resources mem_mb=8000 net=1 --rerun-triggers mtime <target>
#
# Targets:
#   download   the Walloon open-data layers, bulk files, OSM, DEM
#   all        eligibility, potentials, sensitivity, figures, tables
#   report     the LaTeX report in docs/pv_potential_wallonia/
#   infographic  the dashboard in results/infographic/
#
# data/, resources/, logs/ and results/infographic/ are symlinks to
# /sylvain/mount/pypsa-wal-data/workflow_pv_wal/ (run_from_office_computer.md
# §1): nothing heavy is written under /sylvain/git.

import os
from pathlib import Path

# The scripts run with the environment's interpreter but without `conda
# activate`, so GDAL and PROJ would not find their data files.
os.environ.setdefault("PROJ_DATA", "/home/anaconda/envs/pypsa-eur/share/proj")
os.environ.setdefault("GDAL_DATA", "/home/anaconda/envs/pypsa-eur/share/gdal")
os.environ.setdefault("TMPDIR", "/sylvain/mount/pypsa-wal-data/workflow_pv_wal/tmp")


configfile: "config.yaml"


DATA = "data"
RES = "resources"
OUT = "results"
DOCDIR = "../docs/pv_potential_wallonia"
PY = "/home/anaconda/envs/pypsa-eur/bin"

SOURCES = list(config["sources"])
BULK = [k for k in config["bulk"] if "url" in config["bulk"][k]]
PROVINCES = config["bulk"]["dem_lidar"]["provinces"]


wildcard_constraints:
    source="|".join(SOURCES),
    bulk="|".join(BULK),
    prov="|".join(PROVINCES),


localrules:
    download,


rule download:
    input:
        expand(f"{DATA}/{{source}}.gpkg", source=SOURCES),
        expand(f"{DATA}/{{bulk}}/.done", bulk=BULK),
        f"{RES}/dem_20m.tif",
        f"{DATA}/osm_pv.gpkg",
        f"{DATA}/osm_grid.gpkg",


# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
rule retrieve_wallonia_layer:
    message:
        "Retrieving {wildcards.source} from the Géoportail de la Wallonie"
    params:
        spec=lambda w: config["sources"][w.source],
    output:
        f"{DATA}/{{source}}.gpkg",
        f"{DATA}/{{source}}.meta.json",
    log:
        "logs/retrieve_{source}.log",
    resources:
        mem_mb=2000,
    retries: 2
    script:
        "scripts/retrieve_wallonia_layer.py"


rule retrieve_bulk:
    message:
        "Downloading the bulk file {wildcards.bulk}"
    params:
        url=lambda w: config["bulk"][w.bulk]["url"],
    output:
        touch(f"{DATA}/{{bulk}}/.done"),
    log:
        "logs/retrieve_bulk_{bulk}.log",
    resources:
        net=1,
        mem_mb=500,
    retries: 2
    shell:
        """
        set -e
        d=$(dirname {output})
        mkdir -p $d
        curl -sS -L --retry 5 -C - -o $d/archive.zip "{params.url}" > {log} 2>&1
        unzip -o -q $d/archive.zip -d $d >> {log} 2>&1
        rm -f $d/archive.zip
        ls -la $d >> {log}
        """


rule extract_lpis:
    message:
        "Extracting the LPIS agricultural surfaces from the SIGEC 2024 GeoPackage"
    params:
        gdal=PY,
    input:
        f"{DATA}/sigec_2024/.done",
    output:
        f"{DATA}/lpis_agri.gpkg",
        f"{DATA}/lpis_agri.meta.json",
    log:
        "logs/extract_lpis.log",
    shell:
        """
        {params.gdal}/ogr2ogr -f GPKG -nln data {output[0]} {DATA}/sigec_2024/SIGEC_PARC_AGRI_2024.gpkg \
            SIGEC_2024__SURFACE_AGRICOLE > {log} 2>&1
        n=$({params.gdal}/ogrinfo -so {output[0]} data | grep "Feature Count" | awk '{{print $3}}')
        printf '{{"service": "SIGEC 2024 bulk GeoPackage", "layer": "SIGEC_2024__SURFACE_AGRICOLE", "title": "LPIS — surfaces agricoles de référence 2024", "features_written": %s, "retrieved": "%s"}}' $n $(date +%F) > {output[1]}
        """


rule build_regions:
    message:
        "Building the administrative and model Walloon regions"
    params:
        region=config["region"],
        crs=config["grid"]["crs"],
