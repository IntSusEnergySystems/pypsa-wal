        sources=f"{DOCDIR}/generated/table_sources.tex",
    log:
        "logs/make_report_inputs.log",
    script:
        "scripts/make_report_inputs.py"


FIGURES = ["map_exclusions", "map_gisements", "funnel", "gisements", "sensitivity"]
