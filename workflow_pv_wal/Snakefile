        evidence=f"{OUT}/tables/soil_evidence.json",
    output:
        states=f"{IG}/data/states.json",
        landmarks=f"{IG}/data/landmarks.json",
        map=f"{IG}/data/map.png",
        loupe=f"{IG}/data/loupe.png",
    log:
        "logs/infographic_data.log",
    resources:
        mem_mb=7000,
    script:
        "scripts/infographic_data.py"


IG_SOURCES = sorted(str(p) for p in Path("infographic").rglob("*") if p.is_file())


rule infographic_page:
    message:
        "Assembling the dashboard in {IG}"
    input:
        sources=IG_SOURCES,
        states=f"{IG}/data/states.json",
        report=f"{DOCDIR}/pv_potential_wallonia.pdf",
    output:
        f"{IG}/index.html",
    run:
        import shutil

        import re
        import time

        stamp = time.strftime("%Y%m%d%H%M%S")
        for src in input.sources:
            dst = Path(IG) / Path(src).relative_to("infographic")
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
        # Cache-busting: the page, its modules and their imports carry the
        # build stamp, so a republished dashboard is never mixed with a cached one.
        page = Path(IG) / "index.html"
        page.write_text(page.read_text().replace('src="js/app.js"', f'src="js/app.js?v={stamp}"')
                        .replace('href="css/style.css"', f'href="css/style.css?v={stamp}"'))
        for js in (Path(IG) / "js").glob("*.js"):
            js.write_text(re.sub(r'from "\./(\w+)\.js"', rf'from "./\1.js?v={stamp}"', js.read_text()))
        shutil.copy2(input.report, Path(IG) / "pv_potential_wallonia.pdf")


rule infographic:
    input:
        f"{IG}/index.html",


rule infographic_publish:
    message:
        "Publishing the dashboard to {params.url}"
    params:
        p=config["infographic"]["publish"],
        url=lambda w: f"{config['infographic']['publish']['public_url']}/{config['infographic']['publish']['folder']}/",
    input:
        page=f"{IG}/index.html",
    output:
        f"{IG}/published.url",
    shell:
        "rsync -a --delete --chmod=D755,F644 --exclude review/ --exclude published.url "
        "-e 'ssh -i {params.p[identity_file]} -o BatchMode=yes' "
        "{IG}/ {params.p[ssh_user]}@{params.p[ssh_host]}:{params.p[remote_dir]}/{params.p[folder]}/ "
        "&& echo {params.url} > {output}"


