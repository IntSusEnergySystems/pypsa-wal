rule retrieve_osm_turbines:
    message:
        "Retrieving the standing Walloon wind fleet from OpenStreetMap"
    params:
        crs=config["atlite"]["crs"],
    input:
        regions=f"{RES}/regions.gpkg",
    output:
        points=f"{DATA}/osm_wind_turbines.gpkg",
        meta=f"{DATA}/osm_wind_turbines.meta.json",
    log:
        "logs/retrieve_osm_turbines.log",
    retries: 2
    script:
        "scripts/retrieve_osm_turbines.py"


rule validate_fleet:
    message:
        "Testing the constraint set against the standing fleet"
    params:
        config=config,
        # Two machines belong to the same farm if they are within this distance.
        # A real Walloon farm is a string of turbines at just above the array
        # spacing, so 1.5 km is comfortably above one link and well below the
        # inter-farm distance.
        farm_link_m=1500,
    input:
        points=f"{DATA}/osm_wind_turbines.gpkg",
        regions=f"{RES}/regions.gpkg",
        settlements=f"{RES}/settlements_{{turbine}}.gpkg",
        layer_dir=f"{RES}/exclusions_{{turbine}}",
        dwelling_raster=f"{RES}/dwelling_setback_{{turbine}}.tif",
        slope_raster=f"{DATA}/slope_ge7.tif",
        dual_carriageways=OSM_INFRA["dual_carriageways"],
        address_points=f"{DATA}/address_points.gpkg",
        pds_zones=f"{DATA}/pds_zones.gpkg",
    output:
        table=f"{OUT}/tables/fleet_validation_{{turbine}}.json",
    log:
        "logs/validate_fleet_{turbine}.log",
    resources:
        mem_mb=8000,
    script:
        "scripts/validate_fleet.py"


